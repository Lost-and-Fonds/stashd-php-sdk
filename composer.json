{
  "name": "stashd/php-sdk",
  "description": "PHP authoring SDK for Stashd plugins",
  "type": "library",
  "license": "MIT",
  "version": "0.3.7",
  "require": {
    "php": "^8.5",
    "stashd/plugin-api": "^0.2.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "squizlabs/php_codesniffer": "^4.0",
    "pestphp/pest": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "Stashd\\PluginSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stashd\\PluginSdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "test": "vendor/bin/pest",
    "lint": [
      "composer dump-autoload --optimize --strict-psr --dry-run",
      "vendor/bin/php-cs-fixer check --allow-risky=yes --config=.php-cs-fixer.dist.php"
    ],
    "analyse": "vendor/bin/phpstan analyse"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Lost-and-Fonds/plugin-api.git"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
