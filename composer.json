{
  "name": "stashd/php-sdk",
  "description": "PHP 8.5 authoring SDK for the Stashd plugin contract",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "stashd/plugin-api": "^0.2.2"
  },
  "require-dev": {
    "nikic/php-parser": "^5.9",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "squizlabs/php_codesniffer": "^4.0",
    "hipsterjazzbo/php-style": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Stashd\\PluginSdk\\": "src/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:static": "vendor/bin/phpstan analyse",
    "check:docs": "php tools/check-docs.php",
    "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.dist.php",
    "lint": [
      "composer dump-autoload --optimize --strict-psr --dry-run",
      "vendor/bin/php-cs-fixer check --allow-risky=yes --config=.php-cs-fixer.dist.php"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Lost-and-Fonds/plugin-api.git"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
